# Copier ce fichier en "backend/.env" puis adapter les valeurs.
# Le fichier .env ne doit JAMAIS être ajouté à Git (il est ignoré).
# Les valeurs ci-dessous sont des exemples fictifs, à remplacer.
#
# Dans Vercel, ces variables doivent être configurées dans le projet pour
# chaque environnement concerné. Elles sont nécessaires au build ET au
# runtime : le build backend importe Django pour exécuter collectstatic.

# Clé secrète Django — exemple fictif, à remplacer par une valeur unique et robuste.
DJANGO_SECRET_KEY=exemple-fictif-cle-a-remplacer-par-une-valeur-unique

# Développement : true (valeur par défaut si absente). Production : false.
DJANGO_DEBUG=true

# Hôtes autorisés, séparés par des virgules.
# En production, ajouter explicitement le domaine personnalisé et ses variantes.
# En preview Vercel, VERCEL_URL peut suffire si l'accès aux variables système
# est activé dans le projet ; il est ajouté automatiquement par settings.py.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines autorisées pour CORS, séparées par des virgules.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Origines de confiance CSRF (admin Django, session), séparées par des virgules.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Production : PostgreSQL est obligatoire quand DJANGO_DEBUG=false.
# Runtime Neon : utiliser l'URL poolée (hôte contenant "-pooler").
# DATABASE_URL=postgresql://utilisateur:mot-de-passe@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Migrations/seed/createsuperuser : utiliser l'URL directe, sans "-pooler".
# Cette variable n'est pas lue par settings.py ; elle sert uniquement aux
# commandes exécutées localement ou en CI.
# DATABASE_URL_DIRECT=postgresql://utilisateur:mot-de-passe@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Exemple de domaine de production (remplacer par le domaine réel).
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Variables obligatoires dans Vercel lorsque DJANGO_DEBUG=false :
# - DJANGO_SECRET_KEY
# - DJANGO_ALLOWED_HOSTS ou VERCEL_URL
# - DJANGO_CORS_ALLOWED_ORIGINS
# - DJANGO_CSRF_TRUSTED_ORIGINS (origines HTTPS du frontend/admin)
# - DATABASE_URL PostgreSQL
#
# Development : DJANGO_DEBUG=true, SQLite autorisé, VERCEL_URL absent.
# Preview : DJANGO_DEBUG=false, VERCEL_URL fourni par Vercel, base de preview
# ou base dédiée, origines CORS/CSRF explicites si elles sont cross-origin.
# Production : DJANGO_DEBUG=false, domaines personnalisés explicites dans
# DJANGO_ALLOWED_HOSTS/CORS/CSRF ; VERCEL_URL ne remplace pas ces domaines.
#
# Activer "Enable access to System Environment Variables" dans Vercel pour
# recevoir VERCEL_URL. Il est ajouté automatiquement à ALLOWED_HOSTS et à
# CSRF_TRUSTED_ORIGINS sous la forme https://<VERCEL_URL>.
# Il n'est PAS ajouté automatiquement à CORS_ALLOWED_ORIGINS.

# Compte de démonstration (non staff), créé par la commande seed_demo.
DEMO_USERNAME=demo
DEMO_PASSWORD=exemple-fictif-a-remplacer-localement

# Réglages de sécurité appliqués uniquement si DEBUG=false (non utilisés en local).
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
