# Copier ce fichier en "backend/.env" puis adapter les valeurs.
# Le fichier .env ne doit JAMAIS être ajouté à Git (il est ignoré).
# Les valeurs ci-dessous sont des exemples fictifs, à remplacer.

# Clé secrète Django — exemple fictif, à remplacer par une valeur unique et robuste.
DJANGO_SECRET_KEY=exemple-fictif-cle-a-remplacer-par-une-valeur-unique

# Développement : true (valeur par défaut si absente). Production : false.
DJANGO_DEBUG=true

# Hôtes autorisés, séparés par des virgules (obligatoire si DEBUG=false).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines autorisées pour CORS, séparées par des virgules.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Origines de confiance CSRF (admin Django, session), séparées par des virgules.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Production : PostgreSQL est obligatoire quand DJANGO_DEBUG=false.
# DATABASE_URL=postgresql://utilisateur:mot-de-passe@hote/base?sslmode=require

# Compte de démonstration (non staff), créé par la commande seed_demo.
DEMO_USERNAME=demo
DEMO_PASSWORD=exemple-fictif-a-remplacer-localement

# Réglages de sécurité appliqués uniquement si DEBUG=false (non utilisés en local).
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
