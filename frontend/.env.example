# Copier ce fichier en "frontend/.env.local" puis adapter les valeurs.
# Ces variables sont intégrées au build Vite : ne jamais y placer de secret.
VITE_API_URL=http://127.0.0.1:8000/api
VITE_BACKEND_URL=http://127.0.0.1:8000

# Production Vercel : le frontend et Django partagent le même domaine.
# Définir ces valeurs dans les variables d'environnement du projet Vercel.
# VITE_API_URL=/api
# VITE_BACKEND_URL=
