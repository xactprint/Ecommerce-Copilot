# Copier ce fichier en "frontend/.env.local" puis adapter les valeurs.
# Ces variables sont intégrées au build Vite : ne jamais y placer de secret.
VITE_API_URL=http://127.0.0.1:8000/api
VITE_BACKEND_URL=http://127.0.0.1:8000

# Production Vercel : le frontend et Django partagent le même domaine.
# Définir ces valeurs dans le projet Vercel pour le build (Production/Preview).
# VITE_API_URL=/api
# VITE_BACKEND_URL=
# Ne jamais placer DJANGO_SECRET_KEY ou DATABASE_URL dans une variable VITE_*.
